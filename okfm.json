{
  "okfm": "0.2.1",
  "pack": null,

  "_build": "Every folder of documents under `root` gets its own OKF in `out`, plus one for the loose files at the top and a mesh OKF over all of them. `decisions` is excluded because it is an in-place bundle — those files are the concepts, so mirroring them would be a second copy of knowledge that already exists.",
  "build": {
    "root": "docs",
    "root_files": true,
    "exclude": ["decisions"],
    "out": ".okfm",
    "mesh": "mesh",
    "mode": "mirror",
    "vocab_overlays": []
  },

  "bundles": {
    "mesh": "./.okfm/mesh",
    "level-1-view": "./.okfm/level-1-view",
    "level-2-build": "./.okfm/level-2-build",
    "level-3-enrich": "./.okfm/level-3-enrich",
    "docs": "./.okfm/docs",
    "guide": "./.okfm/guide",
    "decisions": "./docs/decisions"
  },

  "read": {
    "web_ui": { "path": "./okfm-web-ui.html", "index": "./okfm-index.json", "serve_port": 7345 },
    "index": {
      "max_concepts": 60,
      "priority_types": ["Attested Computation", "Rule", "Metric", "Perspective"]
    },
    "exclude_scopes": ["guide"]
  },

  "stores": {},
  "federation": { "registry": "./.okfm/mesh" }
}
